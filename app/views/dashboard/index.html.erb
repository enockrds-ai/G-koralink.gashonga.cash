<% content_for :title, "Dashboard | G-KORALINK" %>
<div class="hero">
  <div><h1>Murakaza neza, <%= current_user.display_name %> 👋</h1><div class="muted"><%= @group&.name || "Gashonga KoraLink Saving" %></div></div>
</div>

<div class="grid">
  <div class="card"><div class="label">Ubwizigame bwemejwe</div><div class="metric"><%= number_with_delimiter(@approved_savings) %> RWF</div></div>
  <div class="card"><div class="label">Imari ishyushye</div><div class="metric"><%= number_with_delimiter(@communal_available) %> RWF</div></div>
  <div class="card"><div class="label">Inguzanyo zikora</div><div class="metric"><%= number_with_delimiter(@active_loans) %> RWF</div></div>
  <div class="card"><div class="label">Abanyamuryango</div><div class="metric"><%= @members.count %></div></div>
</div>

<% if @member %>
<div class="sections">
  <section class="card">
    <h2>IZIGAME</h2>
    <p class="muted">Ku wa Kabiri 05:00–08:00 cyangwa Ku wa Gatatu mbere ya 15:00. Umugabane 1 = RWF 500; nturenze imigabane 8 mu cyumweru.</p>
    <%= form_with url: "/savings", method: :post, local: true do %>
      <div class="formrow"><input name="amount" type="number" min="500" step="500" placeholder="Amafaranga" required><input name="note" placeholder="Note / Mobile Money"></div>
      <p><button class="gold" type="submit">KANDA KWIZIGAMA</button></p>
    <% end %>
    <div class="list">
      <% @savings.limit(5).each do |s| %><div class="item"><b><%= number_with_delimiter(s.amount) %> RWF</b> <span class="pill"><%= s.status %></span><br><span class="muted"><%= s.created_at&.strftime("%d/%m/%Y %H:%M") %></span></div><% end %>
    </div>
  </section>

  <section class="card">
    <h2>IMARI ISHYUSHYE</h2>
    <div class="metric"><%= number_with_delimiter(@communal_available) %> RWF</div>
    <p class="muted">Amafaranga ahari ku itsinda. Ushobora gusaba kugeza kuri <b><%= number_with_delimiter(@max_loan) %> RWF</b> (80%), bitewe n'amategeko y'itsinda.</p>
    <hr style="border:0;border-top:1px solid var(--line)">
    <% if @my_loan %>
      <h3>ISHYURA INGuzanyo</h3>
      <p>Balance: <b><%= number_with_delimiter(@my_loan.balance) %> RWF</b></p>
      <%= form_with url: "/repayments", method: :post, local: true do %>
        <input type="hidden" name="loan_id" value="<%= @my_loan.id %>">
        <div class="formrow"><input name="amount" type="number" min="1" max="<%= @my_loan.balance %>" placeholder="Amafaranga yo kwishyura" required><button type="submit">OHEREZA</button></div>
      <% end %>
    <% else %>
      <h3>SABA INGUZANYO</h3>
      <p class="muted">Ushobora gusaba nubwo ubwizigame bwawe ari RWF 0, niba amafaranga rusange aboneka.</p>
      <%= form_with url: "/loans", method: :post, local: true do %>
        <div class="formrow"><input name="amount" type="number" min="1" max="<%= @max_loan %>" placeholder="Amafaranga" required><button type="submit">SABA INGUZANYO</button></div>
      <% end %>
    <% end %>
  </section>
</div>
<% end %>

<div class="sections">
  <section class="card"><h2>ABANYAMURYANGO</h2><p class="muted">Abanyamuryango mubana mu itsinda.</p>
    <div class="list"><% @members.each do |m| %><div class="item"><b><%= m.display_name %></b><br><span class="muted"><%= m.phone %> · <%= m.status %></span></div><% end %></div>
  </section>
  <section class="card"><h2>UBUTUMWA</h2>
    <div class="list"><% @notifications.each do |n| %><div class="item"><b><%= n.title %></b><br><span class="muted"><%= n.body %></span></div><% end %></div>
  </section>
</div>
