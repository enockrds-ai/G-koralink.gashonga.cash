<!doctype html>
<html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>G-KORALINK</title>
<style>body{margin:0;background:#f5f7fa;color:#172033;font-family:Arial}.top{background:#07111f;color:white;padding:18px 5%}.wrap{max-width:1000px;margin:auto;padding:22px 5%}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.card{background:white;border:1px solid #e5e7eb;border-radius:14px;padding:18px;margin:12px 0}.num{font-size:28px;font-weight:800}.nav a{margin-right:14px}.logout{float:right;color:white}</style></head>
<body><div class="top"><form class="logout" action="/logout" method="post"><input type="hidden" name="_method" value="delete"><button>Logout</button></form><b>G-KORALINK</b><div><%= @group&.name || "Gashonga KoraLink Saving" %></div></div>
<div class="wrap"><div class="nav"><a href="/dashboard">Dashboard</a> <a href="/members">Abanyamuryango</a> <a href="/notifications">Ubutumwa</a><% if current_user.role.to_s=="admin" %> <a href="/admin">ADMIN</a><% end %></div>
<h2>Murakaza neza, <%= current_user.display_name %></h2>
<div class="cards"><div class="card">Ubwizigame bwemejwe<div class="num"><%= @approved_savings %> RWF</div></div><div class="card">Inguzanyo zikora<div class="num"><%= @active_loans %> RWF</div></div><div class="card">Abanyamuryango<div class="num"><%= @members.count %></div></div></div>
<% if @member %><h3>IZIGAME</h3><div class="card"><form action="/savings" method="post"><input name="amount" type="number" min="500" step="500" placeholder="Amafaranga"><input name="note" placeholder="Note"><button>Kanda kwizigama</button></form></div>
<% if @my_loan %><h3>Ishyura inguzanyo</h3><div class="card">Balance: <b><%= @my_loan.balance %> RWF</b><form action="/repayments" method="post"><input type="hidden" name="loan_id" value="<%= @my_loan.id %>"><input name="amount" type="number" min="1" max="<%= @my_loan.balance %>"><button>Ohereza ubwishyu</button></form></div><% else %><h3>Saba inguzanyo</h3><div class="card"><form action="/loans" method="post"><input name="amount" type="number" min="1" placeholder="Amafaranga"><button>Saba inguzanyo</button></form></div><% end %><% end %>
<h3>Abanyamuryango</h3><div class="card"><% @members.each do |m| %><p><b><%= m.display_name %></b> — <%= m.phone %></p><% end %></div>
<h3>Ubutumwa</h3><div class="card"><% @notifications.each do |n| %><p><b><%= n.title %></b> — <%= n.body %></p><% end %></div>
</div></body></html>