<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>G-KORALINK</title><style>body{margin:0;background:#f5f7fa;color:#172033;font-family:Arial}.top{background:#07111f;color:white;padding:18px 5%}.wrap{max-width:1000px;margin:auto;padding:22px 5%}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.card{background:white;border:1px solid #e5e7eb;border-radius:14px;padding:18px}.num{font-size:28px;font-weight:800}.logout{float:right;color:white}</style></head><body><div class="top"><a class="logout" href="/logout">Logout</a><b>G-KORALINK</b><div>Gashonga KoraLink Saving</div></div><div class="wrap"><h2>Dashboard</h2><div class="cards"><div class="card">Ubwizigame bwemejwe<div class="num"><%= @approved_savings %> RWF</div></div><div class="card">Inguzanyo zikora<div class="num"><%= @active_loans %> RWF</div></div><div class="card">Abanyamuryango<div class="num"><%= @members.count %></div></div></div><h3>Abanyamuryango</h3><div class="card"><% @members.each do |m| %><p><b><%= m.display_name %></b> — <%= m.phone %></p><% end %></div></div></body></html>