<% content_for :title, "Injira | G-KORALINK" %>
<div style="max-width:430px;margin:35px auto">
  <div class="card">
    <h1>Murakaza neza 👋</h1>
    <p class="muted">Injira muri G-KORALINK</p>
    <%= form_with url: login_path, method: :post, local: true do %>
      <p><label>Email</label><input name="email" type="email" autocomplete="username" required></p>
      <p><label>Passcode y'imibare 5</label><input id="login-pass" name="password" type="password" inputmode="numeric" pattern="\d{5}" maxlength="5" autocomplete="current-password" required></p>
      <p><label><input type="checkbox" onclick="document.getElementById('login-pass').type=this.checked?'text':'password'"> Erekana passcode</label></p>
      <button class="gold" type="submit">INJIRA</button>
    <% end %>
    <p class="muted">Ntabwo ufite konti? <a href="/register" style="font-weight:800">Iyandikishe</a></p>
  </div>
</div>
