<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>G-KORALINK Login</title><%= csrf_meta_tags %><style>body{margin:0;background:#07111f;font-family:Arial;color:#fff;display:grid;place-items:center;min-height:100vh}.box{width:min(92%,390px);background:#fff;color:#111;border-radius:18px;padding:28px;box-sizing:border-box}h1{color:#07111f}input{width:100%;box-sizing:border-box;padding:13px;margin:7px 0 14px;border:1px solid #ddd;border-radius:9px}button{width:100%;padding:13px;border:0;border-radius:9px;background:#d5a83a;font-weight:700}</style></head><body><div class="box"><h1>G-KORALINK</h1><p>Injira muri konti yawe</p><% if flash[:alert] %><p><%= flash[:alert] %></p><% end %><%= form_with url: login_path, method: :post, local: true do %><label>Email</label><input name="email" type="email" required><label>Passcode</label><input name="password" type="password" required inputmode="numeric" maxlength="5"><button type="submit">INJIRA</button><% end %></div></body></html>